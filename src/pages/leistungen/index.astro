---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Arrow from '../../components/Arrow.astro';
import CallToAction from '../../components/CallToAction.astro';

const leistungen = (await getCollection('leistungen')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Leistungen"
  description="Möbel nach Maß, Küchen, Einbauschränke, Treppen und Restaurierung: Das sind die Leistungen der Tischlerei Mustermann in Musterstadt."
>
  <PageIntro
    eyebrow="Leistungen"
    title="Alles, was man aus <em>Holz</em> bauen kann"
    lead="Fast alles zumindest. Von der einzelnen Kommode bis zum kompletten Innenausbau planen, bauen und montieren wir selbst, mit neun Menschen in einer Werkstatt."
  />

  <div class="container liste">
    {
      leistungen.map((l, i) => (
        <article class:list={['eintrag reveal', { 'eintrag--rechts': i % 2 === 1 }]}>
          <a href={`/leistungen/${l.id}/`} class="img-frame hover-zoom eintrag__bild" tabindex="-1" aria-hidden="true">
            <Picture
              src={l.data.image}
              alt=""
              widths={[480, 720, 960, 1400]}
              sizes="(min-width: 60rem) 55vw, 92vw"
              formats={['avif', 'webp']}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
            />
          </a>
          <div class="eintrag__text">
            <span class="eintrag__nr">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="h2">
              <a href={`/leistungen/${l.id}/`}>{l.data.title}</a>
            </h2>
            <p class="eintrag__kurz">{l.data.kurz}</p>
            <ul>
              {l.data.highlights.slice(0, 3).map((h) => <li>{h}</li>)}
            </ul>
            <a href={`/leistungen/${l.id}/`} class="link-arrow">
              Mehr erfahren<span class="visually-hidden"> über {l.data.title}</span> <Arrow />
            </a>
          </div>
        </article>
      ))
    }
  </div>

  <CallToAction />
</BaseLayout>

<style>
  .liste {
    display: grid;
    gap: var(--section);
    padding-bottom: var(--section);
  }
  .eintrag {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }
  .eintrag--rechts .eintrag__bild {
    order: 2;
  }
  .eintrag__bild {
    aspect-ratio: 4 / 3;
  }
  .eintrag__text {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .eintrag__nr {
    font-size: 0.85rem;
    color: var(--oak);
    font-weight: 600;
    letter-spacing: 0.1em;
  }
  h2 a {
    text-decoration: none;
  }
  h2 a:hover {
    font-style: italic;
  }
  .eintrag__kurz {
    font-size: var(--step-1);
    color: var(--ink-2);
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    width: 100%;
  }
  li {
    padding-block: 0.6rem;
    border-top: 1px solid var(--line);
    font-size: 0.95rem;
  }
  li:last-child {
    border-bottom: 1px solid var(--line);
  }
  @media (max-width: 56rem) {
    .eintrag {
      grid-template-columns: 1fr;
    }
    .eintrag--rechts .eintrag__bild {
      order: 0;
    }
  }
</style>
