---
import { Picture } from 'astro:assets';
import Arrow from './Arrow.astro';
import { firma } from '../data/site';
import bild from '../assets/images/oel-maserung.jpg';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Erzählen Sie uns von Ihrem <em>Vorhaben.</em>',
  text = 'Ein erstes Gespräch ist kostenlos und unverbindlich, in der Werkstatt, bei Ihnen zu Hause oder am Telefon. Danach wissen Sie, was möglich ist und was es kostet.',
} = Astro.props;
---

<section class="cta on-image" aria-labelledby="cta-titel">
  <Picture
    src={bild}
    alt=""
    widths={[800, 1400, 2000]}
    sizes="100vw"
    formats={['avif', 'webp']}
    class="cta__bild"
  />
  <div class="container cta__inhalt">
    <h2 id="cta-titel" class="h2" set:html={title} />
    <p>{text}</p>
    <div class="cta__aktionen">
      <a href="/kontakt/" class="btn btn--primary">Termin vereinbaren <Arrow /></a>
      <a href={firma.telefonHref} class="btn btn--ghost">{firma.telefon}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    color: var(--paper);
    padding-block: var(--section);
    overflow: hidden;
  }
  .cta :global(.cta__bild) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cta::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(100deg, rgb(20 14 9 / 0.92) 0%, rgb(20 14 9 / 0.7) 45%, rgb(20 14 9 / 0.25) 100%);
  }
  .cta__inhalt {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  h2 {
    max-width: 13ch;
  }
  h2 :global(em) {
    color: #e7c8a2;
  }
  p {
    max-width: 34rem;
    font-size: var(--step-1);
    color: #e6dccd;
  }
  .cta__aktionen {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
</style>
