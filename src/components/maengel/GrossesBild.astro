---
// Mängelfassung: Foto als großes Original-JPG, ohne kleinere Größen, ohne Lazy Loading und ohne feste Maße
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
}
const { src, alt, class: klasse } = Astro.props;
const bild = await getImage({ src, format: 'jpg', quality: 82 });
---

<img src={bild.src} alt={alt} class:list={['gross-bild', klasse]} />

<style>
  .gross-bild {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
