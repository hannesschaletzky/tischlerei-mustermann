---
import { ersteller } from '../data/site';
import { guteFassung, maengel } from '../data/maengel';
---

<aside class="demobar" aria-label="Hinweis zum Beispielprojekt">
  {
    maengel ? (
      <p class="container">
        Demo mit absichtlich eingebauten Mängeln für den <a href={`${ersteller.url}/websites`}>Website-Check-up</a>.{' '}
        <a href={guteFassung}>Zur fehlerfreien Fassung</a> · <a href={`${ersteller.url}/impressum`}>Impressum</a> ·{' '}
        <a href={`${ersteller.url}/datenschutz`}>Datenschutz</a>
      </p>
    ) : (
      <p class="container">
        Beispielprojekt: Die Tischlerei ist erfunden. Website gestaltet und entwickelt von{' '}
        <a href={ersteller.url}>{ersteller.name}</a>
      </p>
    )
  }
</aside>

<style>
  .demobar {
    background: var(--walnut);
    color: var(--on-walnut-2);
    font-size: 0.8rem;
    letter-spacing: 0.02em;
  }
  p {
    padding-block: 0.55rem;
    text-align: center;
  }
  a {
    color: var(--on-walnut);
    font-weight: 600;
  }
</style>
