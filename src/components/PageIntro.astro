---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="intro container">
  <span class="eyebrow">{eyebrow}</span>
  <h1 class="display" set:html={title} />
  {lead && <p class="lead">{lead}</p>}
  <slot />
</section>

<style>
  .intro {
    padding-top: clamp(3.5rem, 2rem + 6vw, 7.5rem);
    padding-bottom: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    display: grid;
    gap: 1.75rem;
  }
  h1 {
    max-width: 14ch;
  }
  h1 :global(em) {
    color: var(--oak);
  }
</style>
