---
import Logo from './Logo.astro';
import { navigation } from '../data/site';

const pfad = Astro.url.pathname;
const aktiv = (href: string) => pfad.startsWith(href);
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="header__logo">
      <Logo />
      <span class="visually-hidden">, zur Startseite</span>
    </a>

    <nav aria-label="Hauptnavigation" class="header__nav">
      <ul>
        {
          navigation.map((item) => (
            <li>
              <a href={item.href} aria-current={aktiv(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="/kontakt/" class="btn btn--primary header__cta">Projekt anfragen</a>

    <button class="header__toggle" popovertarget="menu" aria-label="Menü öffnen">
      <span></span><span></span>
    </button>
  </div>

  <div id="menu" popover class="menu">
    <div class="menu__head container">
      <Logo />
      <button popovertarget="menu" popovertargetaction="hide" class="menu__close" aria-label="Menü schließen">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.5"></path></svg>
      </button>
    </div>
    <nav aria-label="Mobile Navigation" class="container">
      <ul>
        {
          navigation.map((item) => (
            <li>
              <a href={item.href} aria-current={aktiv(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li><a href="/kontakt/" aria-current={aktiv('/kontakt/') ? 'page' : undefined}>Kontakt</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 4.75rem;
  }
  .header__logo {
    text-decoration: none;
    margin-right: auto;
  }
  .header__nav ul {
    display: flex;
    gap: 2.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .header__nav a {
    position: relative;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    padding-block: 0.5rem;
  }
  .header__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.1rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease);
  }
  .header__nav a:hover::after,
  .header__nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .header__cta {
    padding: 0.75rem 1.25rem;
  }
  .header__toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    position: relative;
  }
  .header__toggle span {
    position: absolute;
    left: 0.6rem;
    right: 0.6rem;
    height: 1.5px;
    background: currentColor;
  }
  .header__toggle span:first-child {
    top: 1.1rem;
  }
  .header__toggle span:last-child {
    top: 1.6rem;
  }

  .menu {
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    border: 0;
    padding: 0;
    background: var(--walnut);
    color: var(--on-walnut);
    opacity: 0;
    transition:
      opacity 0.3s var(--ease),
      display 0.3s allow-discrete,
      overlay 0.3s allow-discrete;
  }
  .menu:popover-open {
    opacity: 1;
  }
  @starting-style {
    .menu:popover-open {
      opacity: 0;
    }
  }
  .menu__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.75rem;
  }
  .menu__close {
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    padding: 0.5rem;
  }
  .menu ul {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
  }
  .menu li {
    border-bottom: 1px solid #4a3c30;
  }
  .menu li a {
    display: block;
    padding-block: 1rem;
    font-family: var(--font-display-stack);
    font-size: 2.6rem;
    line-height: 1.1;
    text-decoration: none;
  }
  .menu li a[aria-current='page'] {
    font-style: italic;
    color: #e7c8a2;
  }

  @media (max-width: 56rem) {
    .header__nav,
    .header__cta {
      display: none;
    }
    .header__toggle {
      display: block;
    }
  }
</style>
