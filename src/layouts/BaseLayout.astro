---
import '../styles/global.css';
import { createHash } from 'node:crypto';
import { Font, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import DemoBar from '../components/DemoBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { firma } from '../data/site';
import standardBild from '../assets/images/werkbank-sonne.jpg';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  krumen?: { name: string; href: string }[];
}

const { title, description, image = standardBild, type = 'website', jsonLd, krumen } = Astro.props;

const seitenTitel = Astro.url.pathname === '/' ? `${firma.name} · ${firma.claim}` : `${title} · ${firma.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, Astro.site);
const standardOg = await getImage({ src: standardBild, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });

const betrieb = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${Astro.site}#betrieb`,
  name: firma.name,
  url: Astro.site?.toString(),
  telephone: firma.telefon,
  email: firma.email,
  foundingDate: String(firma.gruendung),
  address: {
    '@type': 'PostalAddress',
    streetAddress: firma.strasse,
    postalCode: firma.plz,
    addressLocality: firma.ort,
    addressCountry: 'DE',
  },
  openingHours: ['Mo-Th 07:30-17:00', 'Fr 07:30-14:00'],
  image: new URL(standardOg.src, Astro.site).toString(),
  priceRange: '€€€',
};

const seitenDaten = jsonLd && { ...jsonLd, image: ogUrl.toString() };

const brotkrumen = krumen && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ name: 'Start', href: '/' }, ...krumen, { name: title, href: Astro.url.pathname }].map((k, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: k.name,
    item: new URL(k.href, Astro.site).toString(),
  })),
};

// JSON-LD wird nicht ausgeführt, Validatoren werten es aber als Inline-Skript: Hash in die CSP aufnehmen.
const strukturiert = [betrieb, seitenDaten, brotkrumen].filter(Boolean).map((d) => JSON.stringify(d));
for (const json of strukturiert) {
  Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(json).digest('base64')}`);
}
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seitenTitel}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`Journal · ${firma.name}`} href="/rss.xml" />
    <meta name="theme-color" content="#f6f1e8" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={firma.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />

    {strukturiert.map((json) => <script type="application/ld+json" set:html={json} />)}
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <DemoBar />
    <Header />
    <main id="inhalt">
      <slot />
    </main>
    <Footer />
  </body>
</html>
