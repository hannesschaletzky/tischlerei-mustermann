# Interner Webserver im Container. TLS übernimmt der Caddy im infra-Repo.
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# script-src/style-src mit Hashes setzt Astro pro Seite als <meta>; frame-ancestors geht nur als Header
		Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
		Cross-Origin-Opener-Policy same-origin
		X-Frame-Options DENY
		-Server
	}

	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@seiten not path /_astro/*
	header @seiten Cache-Control "public, max-age=0, must-revalidate"

	# Formular ohne JavaScript abgeschickt: Es gibt kein Backend, also zurück zum Formular
	@formular {
		method POST
		path /kontakt/
	}
	redir @formular /kontakt/#anfrage 303

	file_server

	handle_errors 404 {
		encode zstd gzip
		rewrite * /404.html
		file_server
	}
}
